const V3 = (a) => new THREE.Vector3(a[0], a[1], a[2]);
const mergeAll = (gs) => { const mixed = gs.some(g => g.index) && gs.some(g => !g.index); return mergeGeometries(mixed ? gs.map(g => g.index ? g.toNonIndexed() : g) : gs); };

